# YemenJPT API — Environment Configuration
# Copy this to .env and set real values

# Database
DATABASE_URL=postgresql+asyncpg://yemenjpt:yemenjpt_dev@localhost:5432/yemenjpt

# Security — CHANGE IN PRODUCTION
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-64

# AI Provider: "mock" (no API key needed) | "openai" | "ollama"
MODEL_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Models (only used when MODEL_PROVIDER=openai)
MODEL_REASONING=gpt-4o
MODEL_EXTRACTION=gpt-4o-mini
MODEL_CLASSIFICATION=gpt-4o-mini
MODEL_EMBEDDING=text-embedding-3-small
MODEL_TRANSLATION=gpt-4o-mini
MODEL_VISION=gpt-4o

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DEBUG=false

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Archive storage
ARCHIVE_BASE_PATH=./data/archive
