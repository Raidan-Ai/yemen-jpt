# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Security
SECRET_KEY=change-me-in-production-use-openssl-rand-64
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql+asyncpg://yemenjpt:yemenjpt_dev@localhost:5432/yemenjpt

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# LLM / Model provider
MODEL_PROVIDER=litellm
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional ML
ENABLE_EMBEDDINGS=false
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# CORS
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO
